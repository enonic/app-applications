{
  "name": "app-applications",
  "version": "1.0.0",
  "private": true,
  "description": "Enonic XP - Applications App",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "build:dev": "vp build --mode development",
    "dev": "vp build --watch --mode development",
    "pack:server": "vp pack",
    "check": "vp check && pnpm run check:server && pnpm run test",
    "check:fix": "vp check --fix && pnpm run check:server && pnpm run test",
    "check:server": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test --run",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@enonic/ui": "^1.2.0",
    "@nanostores/preact": "^1.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "focus-trap-react": "^12.0.3",
    "nanostores": "^1.5.2",
    "neverthrow": "^8.2.0",
    "preact": "^10.29.8",
    "react-virtuoso": "^4.18.12"
  },
  "devDependencies": {
    "@enonic-types/core": "^8.0.4",
    "@enonic-types/global": "^8.0.4",
    "@enonic-types/lib-i18n": "^8.0.4",
    "@enonic-types/lib-io": "^8.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.4"
    }
  },
  "packageManager": "pnpm@10.33.4"
}
