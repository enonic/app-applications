{
  "name": "app-applications",
  "version": "1.0.0",
  "description": "Enonix XP - Applications App",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/enonic/app-applications"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:dev",
    "build:prod": "pnpm --color /^build:prod:.*$/",
    "build:prod:js": "cross-env BUILD_TARGET=js vite build --mode production",
    "build:prod:css": "cross-env BUILD_TARGET=css vite build --mode production",
    "build:dev": "pnpm --color /^build:dev:.*$/",
    "build:dev:js": "cross-env BUILD_TARGET=js vite build --mode development",
    "build:dev:css": "cross-env BUILD_TARGET=css vite build --mode development",
    "check": "pnpm /^check:.*$/",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint . --quiet --cache",
    "fix": "eslint --fix **/*.ts"
  },
  "dependencies": {
    "@enonic/lib-admin-ui": "link:.xp/dev/lib-admin-ui",
    "dompurify": "~3.4.12",
    "fine-uploader": "^5.16.2",
    "jquery": "^4.0.0",
    "jquery-simulate": "^1.0.2",
    "jquery-ui": "^1.14.2",
    "mousetrap": "^1.6.5",
    "q": "^1.5.1"
  },
  "devDependencies": {
    "@enonic/eslint-config": "^2.3.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@types/postcss-normalize": "^9.0.4",
    "@types/q": "^1.5.8",
    "autoprefixer": "^10.5.4",
    "browserslist-config-enonic": "^1.0.8",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.2",
    "enonic-admin-artifacts": "^2.5.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "less": "^4.8.0",
    "postcss": "^8.5.23",
    "postcss-normalize": "^13.0.1",
    "postcss-sort-media-queries": "^6.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.2.0"
  },
  "browserslist": [
    "extends browserslist-config-enonic"
  ],
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">= 24.15.0",
    "pnpm": ">= 10.33.4",
    "npm": ">= 11.6.2"
  }
}
